# Copy to vision/.env. Do not commit vision/.env.
# The key is read only by the FastAPI process.

NEBIUS_API_KEY=
NEBIUS_MODEL_ID=nvidia/Nemotron-3.5-Super-VL
NEBIUS_BASE_URL=https://api.tokenfactory.us-north1.nebius.com/v1
PORT=8000

# Shared with web/.env. Paid inference routes reject requests that do not send this token.
# /health stays public. Never put this value in a NEXT_PUBLIC_ variable.
VISION_SERVICE_TOKEN=
