# Copy to web/.env. Do not commit web/.env.
# The database password below is the local Docker default, not a production secret.

DATABASE_URL=postgresql://spaceproof:local_dev_password@localhost:5432/spaceproof?schema=public

# Milestone 1 talks only to the PayPal sandbox. Do not set this to live.
PAYPAL_ENVIRONMENT=sandbox

# Server-only. Create these in the PayPal Developer Dashboard:
# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Public sandbox client id used by the PayPal JavaScript SDK.
# This must be the same app as PAYPAL_CLIENT_ID. Never put the secret here.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Webhook verification is not implemented yet. Leave this blank.
PAYPAL_WEBHOOK_ID=

# The fit check does not call the vision service yet.
VISION_SERVICE_URL=http://localhost:8000

# Unused until a vision-language provider is selected. Do not commit a real key.
AI_PROVIDER_API_KEY=
